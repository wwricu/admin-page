{
    cache
}

{$HOSTNAME} {
    tls me@wwr.icu
    encode gzip

    handle_path /* {
        cache
        reverse_proxy {
            to http://blog-page:3000
        }
    }

    log {
        format json
        output file /var/log/caddy.log {
            roll_size 10MiB
            roll_keep 10
        }
    }
}

{$ADMIN_HOSTNAME} {
    tls me@wwr.icu
    encode gzip

    handle_path /api/* {
        reverse_proxy {
            to http://basic-service:8000
        }
    }

    handle /gp {
        reverse_proxy {
            to http://v2ray:8443
            header_up X-Real-IP {remote_host}
        }
    }

    # /bp and /btp removed: the old trojan/btp-over-websocket bad_proxy
    # endpoints are retired (websocket transport dropped in v2). Replacements
    # (vless+xhttp on :8447, btp on :8448) use BPC's own TLS and connect
    # directly, since Caddy cannot carry BPC's single duplex POST.

    handle_path /* {
        root * /root
        file_server
        try_files {path} {path}/ /index.html
    }

    log {
        format json
        output file /var/log/caddy.log {
            roll_size 1MiB
            roll_keep 10
        }
    }
}

{$RESOURCE_HOSTNAME} {
    tls me@wwr.icu
    encode gzip

    handle /image/* {
        reverse_proxy {
            to http://basic-service:8000
        }
    }

    log {
        format json
        output file /var/log/caddy.log {
            roll_size 1MiB
            roll_keep 10
        }
    }
}
